{
  "expo": {
    "name": "DearMI",
    "slug": "dearmi-app",
    "version": "1.0.0",
    "scheme": "dearmi",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chloee0033.dearmiapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.chloee0033.dearmiapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "처방전 사진을 선택하기 위해 갤러리 접근 권한이 필요합니다.",
          "cameraPermission": "처방전을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-SemiBold.ttf",
            "./assets/fonts/Pretendard-Bold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "214f8cd5-3c46-4df1-925b-f82d91192d3d"
      }
    }
  }
}
