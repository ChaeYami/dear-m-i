{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dearmi.link"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dearmi.link"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762582221"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
