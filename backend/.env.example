# ============================================================
# 환경변수 템플릿 — 이 파일을 복사해 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ .env 는 gitignored. 운영 값은 절대 커밋 금지.
# 운영 환경: AWS Secrets Manager 또는 ECS Task Definition env 로 주입.
# 개발 환경: 로컬 .env (gitignored).
# ============================================================

# --- DB ---------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/dearmidb
DB_USERNAME=postgres
DB_PASSWORD=

# --- 보안 -------------------------------------------------------------------
# JWT_SECRET: HS256 용 32바이트(256bit) 이상. 생성: openssl rand -hex 32
JWT_SECRET=
# ENCRYPTION_KEY: AES-256-GCM 키 (Base64 또는 hex 32바이트). 진료기록 본문 암호화.
ENCRYPTION_KEY=

# --- 외부 API ---------------------------------------------------------------
DRUG_INFO_API_KEY=
GEMINI_API_KEY=

# --- AWS --------------------------------------------------------------------
AWS_S3_BUCKET=dearmi-dev-bucket
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- OAuth2 -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- FCM / 결제 -------------------------------------------------------------
FCM_SERVICE_ACCOUNT_KEY=
TOSS_SECRET_KEY=

# --- IAP 영수증 서버 검증 -----------------------------------------------------
# Google Play Developer API 서비스 계정 JSON (Cloud Console → IAM → Service Account → Key).
# Play Console → Setup → API access 에서 권한 부여 필수.
PLAY_DEVELOPER_API_JSON=
PLAY_PACKAGE_NAME=com.chloee0033.dearmiapp

# App Store Server API / JWS 검증
APPLE_BUNDLE_ID=com.chloee0033.dearmiapp
# App Store Connect → App 정보 → Apple ID (숫자) — SignedDataVerifier 필수
APPLE_APP_APPLE_ID=
# SANDBOX (개발/테스트) | PRODUCTION (출시 후). 둘 다 체크 원할 시 코드로 fallback 추가 필요.
APPLE_ENV=SANDBOX
# Apple Root CA (G3) 인증서 경로. 기본값은 src/main/resources/apple-root-ca-g3.cer (내려받아 배치 필요)
APPLE_ROOT_CERT_PATH=classpath:apple-root-ca-g3.cer

# --- CORS (운영 전용. 로컬은 application-local.yml 의 default 사용) -------------
# 콤마 구분 또는 yaml list. 미설정 시 cross-origin 전부 차단 (안전 기본값).
# 예: CORS_ALLOWED_ORIGINS=https://app.dearmi.link,https://web.dearmi.link
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
